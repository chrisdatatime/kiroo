# Copie para .env e preencha. Nunca versione o .env. Valores abaixo são os padrões do código (comentados = opcional).
# Em Docker use .env.docker (ver .env.docker.example e docs/DOCKER.md).

# ============================== 1. Modo e chamadas pagas ==============================
# simulated | real  (real só funciona com STUDIO_ALLOW_PAID_CALLS=true + chave + orçamento na produção)
# Portão único (src/studio/paid_gate.py) vale para Gemini e Anthropic:
# - STUDIO_KILL_SWITCH=1 bloqueia QUALQUER chamada paga, em qualquer ambiente (aviso amigável na interface).
# - STUDIO_ALLOW_PAID_CALLS: padrão 0 em staging/produção (STUDIO_ENV). Em dev, sem a variável, decide o workspace;
#   com 0 explícito, nada pago roda nem em dev.
# - STUDIO_MONTHLY_CAP_USD: teto do mês da PLATAFORMA (todos os workspaces + testes + chat); obrigatório > 0 em
#   staging/produção para haver chamada paga. Também é o teto do mês das produções da CLI (sem workspace).
# - STUDIO_AGENT_DAILY_CAP_USD: teto do dia por agente em cada workspace (0 = sem teto).
STUDIO_MODE=simulated
STUDIO_ALLOW_PAID_CALLS=false
STUDIO_MONTHLY_CAP_USD=0
# STUDIO_KILL_SWITCH=0
# STUDIO_AGENT_DAILY_CAP_USD=0
# Limite padrão (em créditos) de uma produção nova; o servidor aplica, limitado pelo teto efetivo do estúdio. Padrão 80.
# STUDIO_DEFAULT_PRODUCTION_CAP_CREDITS=80

# ============================== 2. Pastas ==============================
# Padrão: ./data, ./assets e ./profiles dentro do projeto. Em Docker: /data, /app/assets, /app/profiles.
STUDIO_DATA_DIR=
STUDIO_ASSETS_DIR=
STUDIO_PROFILES_DIR=
# Referências pessoais da apresentadora (bia/PERFIL BIA.jpg), separadas dos assets da imagem.
# Vazio = o mesmo que STUDIO_ASSETS_DIR. Em Docker: /reference (volume).
STUDIO_REFERENCE_DIR=

# ============================== 3. Gemini (modo real) ==============================
# AI Studio, cobrança separada da assinatura Google AI Pro/Ultra. SEGREDO.
GEMINI_API_KEY=
# Modelos — confira disponibilidade e preço antes de usar (docs/INTEGRACOES.md)
STUDIO_PLANNER_MODEL=gemini-3.8-flash
STUDIO_REVIEWER_MODEL=gemini-3.8-flash
STUDIO_IMAGE_MODEL=gemini-nano-banana-2.1
STUDIO_IMAGE_SIZE=2K
STUDIO_VIDEO_MODEL=gemini-omni-1.1-flash
STUDIO_VIDEO_RESOLUTION=720p

# ============================== 4. Limites da produção ==============================
STUDIO_MAX_INFLIGHT_OPS=3
STUDIO_MAX_IMAGE_ATTEMPTS=4
STUDIO_MAX_VIDEO_ATTEMPTS=3
STUDIO_POLL_INTERVAL_S=4

# ============================== 5. FFmpeg e fonte ==============================
# Vazio = procurar no PATH (e, no Windows, na instalação winget). Em Docker a fonte é DejaVuSans.
STUDIO_FFMPEG=
STUDIO_FFPROBE=
STUDIO_FONT_FILE=
STUDIO_X264_PRESET=medium

# ============================== 6. Rede, proxy e cadastro (docs/RUNBOOK.md) ==============================
# STUDIO_HOST=127.0.0.1                 # em contêiner: 0.0.0.0
# STUDIO_PORT=8765                      # também lê PORT quando existir
# STUDIO_PUBLIC_HOST=app.kiroo.app
# STUDIO_ALLOWED_HOSTS=app.kiroo.app,staging.kiroo.app
# STUDIO_SECURE_COOKIE=1                # produção/staging (cookie Secure + HSTS)
# STUDIO_TRUST_PROXY=none               # none | cloudflare | forwarded
# STUDIO_SIGNUP=closed                  # closed | invite | open
# invite: códigos de uso único gerados com `studio admin create-invite` (STUDIO_INVITE_CODES foi aposentado)
# STUDIO_BOOTSTRAP_ADMIN_EMAIL=         # cria o admin (sem senha) no boot e envia o link
# Limite de requisições em memória (instância única), "N/S" = N a cada S segundos; 0 desliga a regra. 429 + Retry-After.
# STUDIO_RATE_LIMIT=1                   # 0 desliga tudo (não use em staging/produção)
# STUDIO_RATE_API_IP=600/60             # /api/* por IP
# STUDIO_RATE_API_USER=300/60           # /api/* por usuário
# STUDIO_RATE_AUTH=20/300               # /api/auth/* por IP
# STUDIO_RATE_CHAT=12/60                # conversa com agentes, por usuário
# STUDIO_RATE_UPLOAD=10/60              # envio de arquivos, por usuário
# STUDIO_RATE_CREATE=6/300              # criação de produção, por usuário

# ============================== 7. Operação ==============================
# STUDIO_SHUTDOWN_GRACE_S=25
# STUDIO_SHUTDOWN_SETTLE_S=3             # 0 a 15; espera depois da drenagem para o Litestream sincronizar (0 desliga)
# STUDIO_STOP_GRACE_S=40                 # prazo SIGTERM->SIGKILL da plataforma; precisa ser >= grace + 2 + settle + 5

# --- dados e backup (docs/BACKUP.md) ---
# STUDIO_ENV=dev                          # dev | staging | production (prefixo no bucket; staging/production exigem backup)
# BACKUP_R2_ENDPOINT=https://<ID_DA_CONTA>.r2.cloudflarestorage.com
# BACKUP_R2_ACCESS_KEY_ID=                # SEGREDO: só no painel/terminal, chave restrita ao bucket kiroo-backups
# BACKUP_R2_SECRET_ACCESS_KEY=            # SEGREDO
# BACKUP_BUCKET=kiroo-backups
# STUDIO_ALLOW_NO_BACKUP=0               # 1: production sobe sem backup (readyz 503). Emergência.
# STUDIO_RESTORE_ON_EMPTY=0               # 1: restaura do R2 se o volume não tiver banco (nunca sobrescreve)
# STUDIO_WAL_CHECKPOINT_S=300             # checkpoint PASSIVE periódico do WAL (0 desliga)
# STUDIO_RESUME_MAX_ATTEMPTS=3
# STUDIO_LOG_FORMAT=json                # json | text

# ============================== 8. E-mail (opcional) ==============================
# Sem SMTP em desenvolvimento, as mensagens vão para o log do terminal.
# Resend: HOST=smtp.resend.com, PORT=465 (TLS direto) ou 587 (STARTTLS), USER=resend, PASSWORD=<chave de API>.
# Em staging/produção (STUDIO_ENV) sem HOST e MAIL_FROM nada é enviado e nada do conteúdo vai para o log.
# STUDIO_MAIL_TRANSPORT=smtp            # smtp (padrão) | resend_api (HTTPS; use no Railway, que bloqueia SMTP)
# STUDIO_SMTP_HOST=smtp.resend.com
# STUDIO_SMTP_PORT=465
# STUDIO_SMTP_SECURITY=                 # ssl (465) | starttls (outras portas) | none (só 127.0.0.1, testes)
# STUDIO_SMTP_USER=resend
# STUDIO_SMTP_PASSWORD=                 # SEGREDO (chave de API do Resend)
# STUDIO_MAIL_FROM=Kiroo <nao-responda@exemplo.com>   # domínio verificado no Resend (SPF/DKIM)

# ============================== 9. Entrar com Google (opcional) ==============================
# Cliente OAuth "Aplicativo da Web" com o URI de redirecionamento https://$STUDIO_PUBLIC_HOST/api/auth/google/callback
# (fixo, nunca do cabeçalho Host). Sem os dois, o botão não aparece. Passo a passo: docs/GOOGLE-LOGIN.md
# STUDIO_GOOGLE_CLIENT_ID=
# STUDIO_GOOGLE_CLIENT_SECRET=          # SEGREDO

# ============================== 9b. Verificação anti-robô, Cloudflare Turnstile (opcional) ==============================
# As duas juntas ligam o widget em cadastro/login/esqueci a senha/reenvio. Só uma em staging/produção = tudo recusado.
# Chaves de TESTE da Cloudflare para dev local: docs/TURNSTILE.md
# STUDIO_TURNSTILE_SITE_KEY=
# STUDIO_TURNSTILE_SECRET_KEY=          # SEGREDO

# ============================== 10. Chat dos agentes (usa a GEMINI_API_KEY; Anthropic é opcional) ==============================
# STUDIO_CHAT_PROVIDER=gemini           # gemini (padrão) | anthropic
# ANTHROPIC_API_KEY=                    # SEGREDO; só com STUDIO_CHAT_PROVIDER=anthropic (extra `chat`)
# STUDIO_CHAT_ENABLED=1
# STUDIO_CHAT_MODEL=                    # vazio = STUDIO_PLANNER_MODEL (gemini-3.8-flash) ou claude-haiku-5-5 no anthropic
# STUDIO_CHAT_MAX_TOKENS=150
# STUDIO_CHAT_MAX_CHARS=300
# STUDIO_CHAT_PER_DAY=20
# STUDIO_CHAT_PER_HOUR=8
# STUDIO_CHAT_COOLDOWN_S=3
# STUDIO_CHAT_GLOBAL_DAILY_TOKENS=200000
# STUDIO_CHAT_TIMEOUT_S=10
# STUDIO_CHAT_PRICE_IN=                 # US$ por 1M tokens; vazio = tabela do modelo (pricing.py)
# STUDIO_CHAT_PRICE_OUT=
# STUDIO_CHAT_GEMINI_THINKING_LEVEL=    # opcional (ex.: minimal)
# STUDIO_CHAT_FAKE=                     # só testes: 1 = respostas falsas, sem chamar a API

# ============================== 11. Créditos (política provisória) ==============================
# créditos = ceil(USD x câmbio x margem / preço do crédito)
# STUDIO_FX_BRL_PER_USD=5.40
# STUDIO_CREDIT_MARGIN=3.0
# STUDIO_CREDIT_PRICE_BRL=1.00   # só com ele a tela "Seu próximo vídeo" mostra R$
# STUDIO_CREDIT_POLICY_FINAL=           # 1 quando a política deixar de ser provisória

# ============================== 12. Reservadas (Fase D, ainda não usadas) ==============================
# MP_ACCESS_TOKEN=                      # SEGREDO
# MP_WEBHOOK_SECRET=                    # SEGREDO
