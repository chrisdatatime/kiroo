# Copie para .env e preencha. Nunca versione o .env.

# simulated | real  (real só funciona com STUDIO_ALLOW_PAID_CALLS=true + chave + orçamento na produção)
STUDIO_MODE=simulated
STUDIO_ALLOW_PAID_CALLS=false

# Pastas (padrão: ./data e ./assets dentro do projeto)
STUDIO_DATA_DIR=
STUDIO_ASSETS_DIR=

# Gemini API (AI Studio, cobrança separada da assinatura Google AI Pro/Ultra)
GEMINI_API_KEY=

# Modelos — confira disponibilidade e preço antes de usar (docs/INTEGRACOES.md)
STUDIO_PLANNER_MODEL=gemini-3.8-flash
STUDIO_REVIEWER_MODEL=gemini-3.8-flash
STUDIO_IMAGE_MODEL=gemini-nano-banana-2.1
STUDIO_IMAGE_SIZE=2K
STUDIO_VIDEO_MODEL=gemini-omni-1.1-flash
STUDIO_VIDEO_RESOLUTION=720p

# Limites
# Teto de gasto real no mês (US$). 0 = chamadas pagas bloqueadas. A interface pode definir e sobrepor.
STUDIO_MONTHLY_CAP_USD=0
STUDIO_MAX_INFLIGHT_OPS=3
STUDIO_MAX_IMAGE_ATTEMPTS=4
STUDIO_MAX_VIDEO_ATTEMPTS=3
STUDIO_POLL_INTERVAL_S=4

# FFmpeg (vazio = procurar no PATH / instalação winget)
STUDIO_FFMPEG=
STUDIO_FFPROBE=
STUDIO_FONT_FILE=
STUDIO_X264_PRESET=medium

# --- Acesso (opcional) ---
# Envio de e-mails (código de confirmação e link de nova senha). Sem STUDIO_SMTP_HOST, as mensagens vão para o log do servidor.
# STUDIO_SMTP_HOST=smtp.exemplo.com
# STUDIO_SMTP_PORT=587
# STUDIO_SMTP_USER=
# STUDIO_SMTP_PASSWORD=
# STUDIO_MAIL_FROM=Kiroo <nao-responda@exemplo.com>
# Entrar com Google: crie um cliente OAuth "Aplicativo da Web" no Google Cloud com o URI de redirecionamento
# http://127.0.0.1:8765/api/auth/google/callback (e o endereço público, se houver). Sem os dois, o botão não aparece.
# STUDIO_GOOGLE_CLIENT_ID=
# STUDIO_GOOGLE_CLIENT_SECRET=

# --- Rede, cadastro e operação (ver docs/RUNBOOK.md) ---
# STUDIO_HOST=127.0.0.1                 # em contêiner: 0.0.0.0
# STUDIO_PORT=8765                      # também lê PORT quando existir
# STUDIO_PUBLIC_HOST=app.kiroo.app
# STUDIO_ALLOWED_HOSTS=app.kiroo.app,staging.kiroo.app
# STUDIO_SECURE_COOKIE=1                # produção/staging (cookie Secure + HSTS)
# STUDIO_TRUST_PROXY=none               # none | cloudflare | forwarded
# STUDIO_SIGNUP=closed                  # closed | invite | open
# STUDIO_INVITE_CODES=                  # só com STUDIO_SIGNUP=invite
# STUDIO_BOOTSTRAP_ADMIN_EMAIL=         # cria o admin (sem senha) no boot e envia o link
# STUDIO_SHUTDOWN_GRACE_S=25
# STUDIO_RESUME_MAX_ATTEMPTS=3
# STUDIO_LOG_FORMAT=json                # json | text
